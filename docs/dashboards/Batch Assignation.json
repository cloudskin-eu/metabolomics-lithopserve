{
  "title": "Split Assignment Duration per TID",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "uid": "split_assignment_tid",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "exported_instance",
        "label": "Executor ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(batch_started, exported_instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(batch_started, exported_instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "hide": 0,
        "regex": "",
        "sort": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 5, "x": 0, "y": 0},
      "targets": [{"expr": "job_num_requests{exported_instance=~\"$exported_instance\", job_label=\"None\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Batch Size",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 5, "x": 5, "y": 0},
      "targets": [{"expr": "job_batch_size{exported_instance=~\"$exported_instance\", job_label=\"None\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Number of Batches",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 5, "x": 10, "y": 0},
      "targets": [{"expr": "job_num_splits{exported_instance=~\"$exported_instance\", job_label=\"None\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Task Managers",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 5, "x": 15, "y": 0},
      "targets": [{"expr": "job_num_task_managers{exported_instance=~\"$exported_instance\", job_label=\"None\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Memory (MB)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "job_memory{exported_instance=~\"$exported_instance\", job_label=\"None\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "MB", "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "state-timeline",
      "title": "Batch Assignment Timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "current_batch{exported_instance=~\"$exported_instance\"}",
          "format": "time_series",
          "refId": "A",
          "legendFormat": "Task Manager {{task_manager}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "--",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": { "text": "Startup", "color": "blue" },
                "0": { "text": "Sync", "color": "gray" }
              }
            },
            {
              "type": "range",
              "options": {
                "from": "1",
                "to": null,
                "text": "Batch",
                "color": "orange"
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": -1, "color": "blue" },
              { "value": 0, "color": "gray" },
              { "value": 1, "color": "orange" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "always",
        "alignValue": "left",
        "rowHeight": 0.6,
        "legend": {
          "show": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "time": {
        "from": "now-6h",
        "to": "now"
      }
    },
    {
      "type": "stat",
      "title": "Completed Batches",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "count(batch_finished{exported_instance=~\"$exported_instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 0, "unit": "none", "noValue": "--" },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "reduceOptions": { "calcs": [ "lastNotNull" ] }
      }
    },
    {
      "type": "stat",
      "title": "Job Latency (s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 },
      "targets": [
        {
          "expr": "(job_finished_timestamp{exported_instance=~\"$exported_instance\"} - job_start_timestamp{exported_instance=~\"$exported_instance\"}) or (time() - job_start_timestamp{exported_instance=~\"$exported_instance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "--"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Throughput (req/s)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 10},
      "targets": [{"expr": "sum(max by (batch_id) (split_inputs_count{exported_instance=~\"$exported_instance\"})) / (max(max by (batch_id) (batch_finished{exported_instance=~\"$exported_instance\"})) - min(min by (batch_id) (batch_started{exported_instance=~\"$exported_instance\"})))", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "none", "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Average Batch Latency (s)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "targets": [{
        "expr": "avg(max by (exported_instance, task_manager, batch_id) (batch_finished{exported_instance=~\"$exported_instance\"}) - min by (exported_instance, task_manager, batch_id) (batch_started{exported_instance=~\"$exported_instance\"}))",
        "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "--", "color": {"mode": "continuous-GrYlRd"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 10}]}, "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["mean"], "fields": "", "values": false}, "orientation": "horizontal", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true}
    },
    {
      "type": "stat",
      "title": "Average Batches per Task Manager",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "targets": [{
        "expr": "avg(count(count_over_time(batch_finished{exported_instance=~\"$exported_instance\"}[6h])) by (task_manager))",
        "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2, "noValue": "--", "color": {"mode": "continuous-GrYlRd"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 100}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "horizontal", "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto", "wideLayout": true}
    },
    {
      "type": "stat",
      "title": "Average Requests per Task Manager",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "targets": [{
        "expr": "avg(sum by (task_manager) (split_inputs_count{exported_instance=~\"$exported_instance\"}))",
        "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2, "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },

    {
      "type": "stat",
      "title": "Total Cost ($)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22},
      "targets": [{
      "expr": "(((job_finished_timestamp{exported_instance=~\"$exported_instance\"} + 0*job_start_timestamp{exported_instance=~\"$exported_instance\"}) or (time() + 0*job_start_timestamp{exported_instance=~\"$exported_instance\"})) - job_start_timestamp{exported_instance=~\"$exported_instance\"}) * job_memory{exported_instance=~\"$exported_instance\"} * job_num_task_managers{exported_instance=~\"$exported_instance\"} * job_cost_per_ms_mb{exported_instance=~\"$exported_instance\"} * 1000",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"decimals": 4, "unit": "currencyUSD", "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Job Throughput/Cost",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
      "targets": [{"expr": "(sum(max by (batch_id) (split_inputs_count{exported_instance=~\"$exported_instance\"})) / (max(max by (batch_id) (batch_finished{exported_instance=~\"$exported_instance\"})) - min(min by (batch_id) (batch_started{exported_instance=~\"$exported_instance\"})))) / sum((((job_finished_timestamp{exported_instance=~\"$exported_instance\"} + 0*job_start_timestamp{exported_instance=~\"$exported_instance\"}) or (time() + 0*job_start_timestamp{exported_instance=~\"$exported_instance\"})) - job_start_timestamp{exported_instance=~\"$exported_instance\"}) * job_memory{exported_instance=~\"$exported_instance\"} * job_num_task_managers{exported_instance=~\"$exported_instance\"} * job_cost_per_ms_mb{exported_instance=~\"$exported_instance\"} * 1000)", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "none", "noValue": "--"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "bargauge",
      "title": "Batches Processed per Task Manager",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(count_over_time(batch_finished{exported_instance=~\"$exported_instance\"}[6h])) by (task_manager)",
          "legendFormat": "Task Manager {{task_manager}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "noValue": "--"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "bargauge",
      "title": "Batch Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "expr": "max by (exported_instance, task_manager, batch_id) (batch_finished{exported_instance=~\"$exported_instance\"}) - min by (exported_instance, task_manager, batch_id) (batch_started{exported_instance=~\"$exported_instance\"})",
          "legendFormat": "{{batch_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "noValue": "--"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Active Duration per Task Manager",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(batch_finished{exported_instance=~\"$exported_instance\"}) by (task_manager) - min(batch_started{exported_instance=~\"$exported_instance\"}) by (task_manager)",
          "legendFormat": "Task Manager {{task_manager}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "noValue": "--"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}